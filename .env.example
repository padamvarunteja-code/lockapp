# Aegis server configuration — copy to .env.local and fill in.
PORT=3000
NODE_ENV=development
APP_ENV=development
TRUST_PROXY=loopback

# Production admin bootstrap (REQUIRED in production — server refuses to start without these).
ADMIN_BOOTSTRAP_USER=onlyus_admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-to-a-long-random-password

# HMAC secret for the tamper-evident admin audit chain (REQUIRED in production, >= 16 chars).
AUDIT_CHAIN_SECRET=change-me-to-32-plus-random-hex-chars

# Optional overrides for database file locations.
# DATABASE_FILE=data/db.dev.json
# ADMIN_DATABASE_FILE=data/admin.dev.json

# Persistent storage root. Set to a mounted disk in production
# (e.g. DATA_DIR=/data on Render) so accounts, sessions, messages,
# vault files, and admin data survive restarts. Without it, ./data
# is used and everything is wiped whenever the host restarts.
# DATA_DIR=/data

# Free-tier persistence via Postgres (e.g. a free Supabase project).
# When set, every mutation is mirrored into Postgres and reloaded at
# boot, so all data survives restarts with NO disk needed. Without it,
# the app is file-only (see DATA_DIR above).
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres
# Set PGSSLMODE=disable only for a local non-TLS Postgres.
# PGSSLMODE=disable
